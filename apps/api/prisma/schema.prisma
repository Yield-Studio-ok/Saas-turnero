generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  BASIC
  PRO
  PREMIUM
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  firebaseUid   String?  @unique
  password      String?
  name          String?
  role          String   @default("user")
  credits       Int      @default(0)
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  businesses             Business[]
  reviews                Review[]
  legalNoticeAcceptances LegalNoticeAcceptance[]

  @@map("users")
}

model Business {
  id          String           @id @default(uuid())
  name        String
  description String?
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [id])
  plan        SubscriptionPlan @default(BASIC)
  imageUrls   String[]         @default([])
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  employees    Employee[]
  schedules    Schedule[]
  services     Service[]
  products     Product[]
  productSales   ProductSale[]
  reviews        Review[]
  appointments   Appointment[]
  employeeBlocks EmployeeBlock[]
  customerRatings CustomerRating[]

  @@map("businesses")
}

model Employee {
  id         String   @id @default(uuid())
  name       String
  email      String?
  phone      String?
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  schedules       Schedule[]
  shifts          Shift[]
  appointments    Appointment[]
  productSales    ProductSale[]
  employeeBlocks  EmployeeBlock[]
  customerRatings CustomerRating[]

  @@map("employees")
}

model Schedule {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = Sunday, 1 = Monday, etc.
  startTime  String // e.g. "09:00"
  endTime    String // e.g. "18:00"
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("schedules")
}

model Service {
  id           String        @id @default(uuid())
  name         String
  description  String?
  price        Float
  duration     Int // duration in minutes
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  appointments Appointment[]

  @@map("services")
}

model LegalNotice {
  id             String   @id @default(uuid())
  title          String
  content        String   @db.Text
  version        String   @default("1.0")
  targetUserRole String?  @map("target_user_role")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  acceptances LegalNoticeAcceptance[]

  @@map("legal_notices")
}

model LegalNoticeAcceptance {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalNoticeId String      @map("legal_notice_id")
  legalNotice   LegalNotice @relation(fields: [legalNoticeId], references: [id], onDelete: Cascade)
  acceptedAt    DateTime    @default(now()) @map("accepted_at")

  @@unique([userId, legalNoticeId])
  @@map("legal_notice_acceptances")
}

model Shift {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clockIn    DateTime  @default(now())
  clockOut   DateTime?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("shifts")
}

model Product {
  id          String        @id @default(uuid())
  name        String
  description String?
  price       Float
  stock       Int           @default(0)
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales       ProductSale[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("products")
}

model ProductSale {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessId    String   @map("business_id")
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId    String   @map("employee_id")
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  quantity      Int      @default(1)
  unitPrice     Float    @map("unit_price")
  total         Float
  paymentMethod String   @map("payment_method") // "cash", "card", "transfer"
  clientName    String?  @map("client_name")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("product_sales")
}

model Appointment {
  id                 String  @id @default(uuid())
  date               String // YYYY-MM-DD
  startTime          String // HH:mm
  endTime            String // HH:mm
  status             String  @default("confirmed") // "confirmed", "cancelled"
  customerName       String
  customerEmail      String
  customerPhone      String?
  notes              String?
  cancellationReason String?
  paidAmount         Float?
  tip                Float?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  review    Review?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("appointments")
}

model Review {
  id            String       @id @default(uuid())
  rating        Int
  comment       String?
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("reviews")
}

model EmployeeBlock {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       String   // YYYY-MM-DD
  startTime  String   @map("start_time") // HH:mm
  endTime    String   @map("end_time")   // HH:mm
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("employee_blocks")
}

model CustomerRating {
  id            String    @id @default(uuid())
  businessId    String    @map("business_id")
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId    String?   @map("employee_id")
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  customerName  String    @map("customer_name")
  customerEmail String?   @map("customer_email")
  customerPhone String?   @map("customer_phone")
  rating        Int       // 1 to 5
  comment       String?
  punctuality   String?   @default("a_tiempo") // "a_tiempo", "tarde", "no_asistio"
  appointmentId String?   @map("appointment_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("customer_ratings")
}
